{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ware-pay",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    { "pattern": "pay.mobiware.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
